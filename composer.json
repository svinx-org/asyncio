{
    "name": "eor_bah545/asyncio",
    "type": "library",
    "version": "0.1.0",
    "description": "Async/await for PHP 8.1+ using Fibers. Event loop, promises, timers, HTTP server — all in one file, no dependencies.",
    "keywords": [
       "php",
       "asynchrone"
    ],
    "autoload": {
        "psr-4": {
            "EorBah545\\Asyncio\\": "src/"
        },
        "files": [
            "src/functions.php" 
         ]
    },
    "autoload-dev": {
        "psr-4": {
            "EorBah545\\Asyncio\\Tests": "tests/",
            "EorBah545\\Asyncio\\Examples\\": "examples/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap vendor/autoload.php tests"
    },
    "authors": [
        {
            "name": "EORBAH",
            "email": "elle.oumarrafiou@gmail.com"
        }
    ],
    "license": "MIT",
    "homepage": "https://github.com/EORBAH/asyncio",
    "support": {
        "issues": "https://github.com/EORBAH/asyncio/issues",
        "source": "https://github.com/EORBAH/asyncio"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    }
}
